<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permits cleartext HTTP communication with local LAN server (e.g., 10.x.x.x, 192.168.x.x) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
